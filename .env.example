# EduCore environment configuration.
# Copy this file to .env and replace every value. .env must never be committed.
# The values below are illustrative examples, not real credentials.

# Spring profile: dev (default; applies the synthetic demo seed), prod (no seed; every secret and the
# bootstrap admin below are mandatory, startup fails naming each missing variable). test is for automated tests only.
SPRING_PROFILES_ACTIVE=dev

# JDBC URL the backend uses when started outside Docker (e.g. `./mvnw spring-boot:run`).
# Inside docker-compose the backend URL is derived from EDUCORE_DB_NAME and the postgres-db service host.
EDUCORE_DB_URL=jdbc:postgresql://localhost:5432/educore_db

# Database name created by the postgres container and used by the backend container.
EDUCORE_DB_NAME=educore_db

# Database user: creates the role in the postgres container and is used by the backend to connect.
EDUCORE_DB_USERNAME=educore_user

# Database password for EDUCORE_DB_USERNAME. Choose a long random value, e.g. `openssl rand -base64 24`.
EDUCORE_DB_PASSWORD=change-me-local-db-password

# JWT HMAC signing secret: base64-encoded, at least 32 bytes after decoding (startup fails otherwise).
# Intentionally empty here: generate your own value with `openssl rand -base64 48` and paste it after "=".
EDUCORE_JWT_SECRET=

# Previous JWT signing secret, set only during a key rotation (same format as EDUCORE_JWT_SECRET).
# Tokens signed with it stay valid until they expire; new tokens use EDUCORE_JWT_SECRET.
# Leave empty outside a rotation. Procedure: docs/security/KEY_ROTATION.md.
EDUCORE_JWT_SECRET_PREVIOUS=

# Server-side pepper for login throttling: usernames are stored in login_attempt only as
# HMAC-SHA-256(pepper, username). At least 32 characters; generate with `openssl rand -base64 48`.
# Required in prod (startup fails without it). Optional in dev: when empty a random per-process value is
# used, so lockout counters reset on restart. Intentionally empty here: generate your own value.
EDUCORE_LOGIN_PEPPER=

# Comma-separated browser origins allowed to call the API cross-origin.
# dev and docker-compose default to http://localhost:3000; prod defaults to none (same-origin behind the proxy).
EDUCORE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# First ADMIN account, created at startup only when no ADMIN exists. Set both or neither.
# Required in prod; optional in dev (the dev seed already contains an ADMIN, so nothing is created there).
# The password must be at least 12 characters; it is stored as a BCrypt hash and must be changed on first use.
# Intentionally empty here: choose your own values.
EDUCORE_BOOTSTRAP_ADMIN_USERNAME=
EDUCORE_BOOTSTRAP_ADMIN_PASSWORD=
