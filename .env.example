# EduCore environment configuration.
# Copy this file to .env and replace every value. .env must never be committed.
# The values below are illustrative examples, not real credentials.

# Spring profile: dev (default; applies the synthetic demo seed), prod (no seed; every secret and the
# bootstrap admin below are mandatory, startup fails naming each missing variable). test is for automated tests only.
SPRING_PROFILES_ACTIVE=dev

# JDBC URL the backend uses when started outside Docker (e.g. `./mvnw spring-boot:run`).
# Inside docker-compose the backend URL is derived from EDUCORE_DB_NAME and the postgres-db service host.
# The compose database is reachable on localhost:5432 only with docker-compose.dev.yml (bound to 127.0.0.1).
EDUCORE_DB_URL=jdbc:postgresql://localhost:5432/educore_db

# Database name created by the postgres container and used by the backend container.
EDUCORE_DB_NAME=educore_db

# Database owner: created as the superuser of the postgres container (POSTGRES_USER). Flyway migrates the schema as
# this role and the backup sidecar dumps as it; inside docker-compose the backend's connection pool never uses it.
# A local run outside Docker (`./mvnw spring-boot:run`) with a single database user may use it for both.
EDUCORE_DB_USERNAME=educore_user

# Password of EDUCORE_DB_USERNAME. Choose a long random value, e.g. `openssl rand -base64 24`.
EDUCORE_DB_PASSWORD=change-me-local-db-password

# Least-privilege runtime role of the backend (DML only: no DDL, no extensions, no COPY ... PROGRAM). Created by
# infra/postgres/init/01-roles.sh on the first start of an empty database; for an existing database see
# docs/ops/UPGRADE.md ("Least-privilege database role"). Must differ from EDUCORE_DB_USERNAME (prod refuses to
# start otherwise); lower-case letters, digits and underscores.
EDUCORE_DB_APP_USERNAME=educore_app

# Password of EDUCORE_DB_APP_USERNAME; a different long random value, e.g. `openssl rand -base64 24`.
EDUCORE_DB_APP_PASSWORD=change-me-local-app-password

# Role Flyway migrates the schema with (the owner). docker-compose sets both from EDUCORE_DB_USERNAME /
# EDUCORE_DB_PASSWORD; set them here only for a run outside Docker that separates the roles. Both or neither;
# required in prod and different from the runtime role. Empty: Flyway uses the connection pool's role.
EDUCORE_DB_MIGRATION_USERNAME=
EDUCORE_DB_MIGRATION_PASSWORD=

# JWT HMAC signing secret: base64-encoded, at least 32 bytes after decoding (startup fails otherwise).
# Intentionally empty here: generate your own value with `openssl rand -base64 48` and paste it after "=".
EDUCORE_JWT_SECRET=

# Previous JWT signing secret, set only during a key rotation (same format as EDUCORE_JWT_SECRET).
# Tokens signed with it stay valid until they expire; new tokens use EDUCORE_JWT_SECRET.
# Leave empty outside a rotation. Procedure: docs/security/KEY_ROTATION.md.
EDUCORE_JWT_SECRET_PREVIOUS=

# Server-side pepper for login throttling: usernames are stored in login_attempt only as
# HMAC-SHA-256(pepper, username). At least 32 characters; generate with `openssl rand -base64 48`.
# Required in prod (startup fails without it). Optional in dev: when empty a random per-process value is
# used, so lockout counters reset on restart. Intentionally empty here: generate your own value.
EDUCORE_LOGIN_PEPPER=

# AES-256 key encrypting webhook signing secrets at rest (AES-256-GCM): base64 of exactly 32 bytes.
# Generate with `openssl rand -base64 32`. Required in prod and docker-compose; optional for a local dev run
# (a random per-process key is used, so stored webhook secrets cannot be decrypted after a restart).
# Changing it makes existing webhook secrets unreadable (re-create the subscriptions). Intentionally empty here.
EDUCORE_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API cross-origin.
# dev and docker-compose default to http://localhost:3000; prod defaults to none (same-origin behind the proxy).
EDUCORE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated IPv4 addresses or CIDR blocks of the reverse proxies whose X-Forwarded-For / X-Forwarded-Proto
# headers are trusted (e.g. the nginx container or the compose network, 172.18.0.0/16). Empty: no proxy is
# trusted and the headers are ignored. Blocks broader than /8 (e.g. 0.0.0.0/0) fail startup. In prod the TLS-terminating proxy must be listed, otherwise every request
# is refused with 403 request/https-required (docs/security/HEADERS.md).
EDUCORE_IPACCESS_TRUSTED_PROXIES=

# Append-only erasure ledger (one line per purged account, keyed digests only; docs/ops/BACKUP_RESTORE.md). Required
# in prod. docker-compose sets it to /var/lib/educore/erasure-ledger.log on the educore_erasure_ledger volume, which
# is not part of the database dump; set it here only for a run outside Docker. Empty: no file (dev).
EDUCORE_ERASURE_LEDGER_FILE=

# First ADMIN account, created at startup only when no ADMIN exists. Set both or neither.
# Required in prod; optional in dev (the dev seed already contains an ADMIN, so nothing is created there).
# The password must be at least 12 characters; it is stored as a BCrypt hash and must be changed on first use.
# Intentionally empty here: choose your own values.
EDUCORE_BOOTSTRAP_ADMIN_USERNAME=
EDUCORE_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------
# Backup sidecar (infra/backup/docker-compose.backup.yml). Every BACKUP_* key is optional; the database
# connection reuses EDUCORE_DB_NAME / EDUCORE_DB_USERNAME / EDUCORE_DB_PASSWORD. See docs/ops/BACKUP_RESTORE.md.

# Five-field cron expression for the daily pg_dump, evaluated in BACKUP_TZ.
BACKUP_SCHEDULE=0 2 * * *

# Time zone of BACKUP_SCHEDULE. Backup file names always carry UTC timestamps.
BACKUP_TZ=UTC

# true runs one backup immediately when the sidecar starts, then follows the schedule.
BACKUP_RUN_ON_START=false

# Local retention in distinct periods: days with a daily dump, ISO weeks with a weekly dump, days with a csv_uploads/done
# archive (only with BACKUP_ARCHIVE_CSV=true; older archives are pruned either way).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_CSV=14

# Healthcheck limit: the sidecar turns unhealthy when the last complete backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=26

# true also archives csv_uploads/done nightly (csv-done/*.tar.gz). Off by default: processed CSV files hold names and
# student numbers, an archive would keep a purged student for BACKUP_KEEP_CSV more days, and the backend no longer
# keeps processed files at all (educore.ingestion.retain-processed-days = 0). docs/ops/DATA_RETENTION.md.
BACKUP_ARCHIVE_CSV=false

# Off-site copy to S3-compatible storage with rclone. Empty BACKUP_S3_BUCKET disables the upload.
# Uploads use `rclone copy`, which does not by itself protect remote history: enable bucket versioning + Object Lock and use a
# key without delete permission (docs/ops/BACKUP_RESTORE.md); set remote retention as a bucket lifecycle rule.
BACKUP_S3_BUCKET=

# S3 API endpoint (required with a bucket), e.g. https://s3.eu-central-1.amazonaws.com or an R2/MinIO/Wasabi URL.
BACKUP_S3_ENDPOINT=

# Region, when the provider needs one (e.g. eu-central-1). Empty otherwise.
BACKUP_S3_REGION=

# Key prefix inside the bucket.
BACKUP_S3_PREFIX=educore

# rclone S3 provider name: AWS, Cloudflare, Minio, Wasabi, ... or Other.
BACKUP_S3_PROVIDER=Other

# Credentials of a key that may only write to that bucket/prefix, without delete permission (required with a bucket).
# Intentionally empty here.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------
# Production edge (docker-compose.prod.yml, docs/ops/TLS.md). Ignored by the development compose files.

# Public origin of the site, https://host[:port] without path. Required by docker-compose.prod.yml: it prefixes
# sitemap URLs and is the allowed Origin of the refresh/logout calls (the prod CORS list stays empty).
# Bound to educore.seo.base-url (application.yml). The prod profile refuses to start when it is unset, http or a
# localhost address. Development default: http://localhost:3000.
EDUCORE_SEO_BASE_URL=https://educore.example.org

# Origin the edge image build fetches the public catalog from (docker-compose.prod.yml prerenders the public
# pages at build time and fails when it is unreachable or has no published course). Empty = EDUCORE_SEO_BASE_URL,
# i.e. the running site; docs/ops/TLS.md "First installation" covers the very first build.
EDUCORE_PUBLIC_API_URL=

# Host ports of the edge nginx (HTTP for the ACME challenge and the HTTPS redirect; HTTPS for the site).
EDUCORE_HTTP_PORT=80
EDUCORE_HTTPS_PORT=443

# Certificate source. Option A: an absolute host directory containing fullchain.pem and privkey.pem (readable by
# uid 101). Option B: leave as educore_tls (the named volume) and start with --profile certbot.
EDUCORE_TLS_SOURCE=educore_tls

# Option B only (certbot profile): comma-separated host names (the first names the certificate), the ACME account
# e-mail for expiry notices, and true to use the Let's Encrypt staging CA for a dry run.
EDUCORE_TLS_DOMAINS=educore.example.org
EDUCORE_ACME_EMAIL=ops-alerts@example.org
EDUCORE_ACME_STAGING=false
