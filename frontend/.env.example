# EduCore frontend environment. Copy to .env.local (git-ignored) and adjust.
#
# Every VITE_* value is compiled into the JavaScript bundle and is readable by anyone who loads the page.
# Only public values may use the VITE_ prefix: never put secrets, tokens or passwords here.

# Base URL of the API, ending in /api. The app calls "<base>/v1/...", e.g. "/api/v1/auth/login".
# - Default "/api" (same origin): `npm run dev` / `npm run preview` proxy /api to EDUCORE_DEV_PROXY_TARGET,
#   and nginx proxies /api in the container. No CORS is involved.
# - Direct mode: "http://localhost:8081/api" makes the browser call the backend on port 8081 itself. The backend
#   must then allow the page origin (EDUCORE_CORS_ALLOWED_ORIGINS, dev default http://localhost:3000), and the
#   refresh cookie is sent cross-origin with credentials on the auth calls.
VITE_API_BASE_URL=/api

# Dev-server proxy target for /api (read by vite.config.ts only; no VITE_ prefix, so it never reaches the bundle).
# 8080 = `./mvnw spring-boot:run`; 8081 = the docker-compose backend (host port 8081 -> container 8080).
EDUCORE_DEV_PROXY_TARGET=http://localhost:8080
